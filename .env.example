# No API keys needed for free demo routing:
# - OSRM for routing (https://project-osrm.org/)
# - Nominatim for geocoding (https://nominatim.org/)

# Optional: Set to 'true' to use mock data during development
VITE_USE_MOCK_DATA=false

# Firebase Configuration (Step 3 Setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OpenRouter AI Chatbot Key (Optional)
VITE_OPENROUTER_API_KEY=
